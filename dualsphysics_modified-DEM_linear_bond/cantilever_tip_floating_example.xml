<?xml version="1.0" encoding="UTF-8" ?>
<case>
  <casedef>
    <constantsdef>
      <gravity x="0" y="0" z="0" />
      <rhop0 value="1000" />
      <rhopgradient value="1" />
      <hswl value="0.0" auto="false" />
      <gamma value="7" />
      <speedsystem value="5" auto="false" />
      <coefsound value="10" />
      <speedsound value="0" auto="true" />
      <b value="1.1200e+05" auto="false" />
      <coefh value="1.0" />
      <cflnumber value="0.1" />
    </constantsdef>

    <mkconfig boundcount="88" fluidcount="0" />

    <geometry>
      <definition dp="0.00125">
        <pointmin x="0.18" y="-0.1" z="0.17" />
        <pointmax x="0.9" y="0.1" z="0.23" />
      </definition>

      <commands>
        <list name="BeamSeg" printcall="false">
          <drawbox><boxfill>solid</boxfill><point x="0.2000" y="0.0" z="0.1900" /><size x="0.00625" y="0.008" z="0.0200" /></drawbox>
          <setmknextbound next="true" />
          <move x="0.00625" y="0" z="0" />
        </list>
        <mainlist>
          <setdrawmode mode="full" />

          <!-- Fixed clamp/root: 10 segments = 0.0625 m -->
          <setmkbound mk="0" />
          <runlist name="BeamSeg" times="10" />

          <!-- Floating cantilever beam: 77 segments = 0.48125 m -->
          <setmkbound mk="10" />
          <runlist name="BeamSeg" times="77" />

          <!-- Tip segment, now also a floating body -->
          <matrixreset />
          <setmkbound mk="87" />
          <drawbox><boxfill>solid</boxfill><point x="0.74375" y="0.0" z="0.1900" /><size x="0.00625" y="0.008" z="0.0200" /></drawbox>

          <shapeout file="" reset="true" />
        </mainlist>
      </commands>
    </geometry>

    <floatings>
      <floating mkbound="10-87" property="soft-wood" relativeweight="1" />
    </floatings>

    <properties>
      <propertyfile file="Floating_Materials.xml" path="materials" />
      <links>
        <link mkbound="0-9" property="soft-wood" />
        <link mkbound="87" property="soft-wood" />
      </links>
    </properties>
  </casedef>

  <execution>
    <special>
      <accinputs>
        <accinput mkbound="87">
          <time start="0.01" end="5.0" />
          <acccentre x="0.746875" y="0.0" z="0.1900" />
          <globalgravity value="1" />
          <acctimes>
            <timevalue time="0.01" linx="0" liny="0" linz="-0.00125" angx="0" angy="0" angz="0" />
            <timevalue time="0.06" linx="0" liny="0" linz="-0.00250" angx="0" angy="0" angz="0" />
            <timevalue time="0.11" linx="0" liny="0" linz="-0.00375" angx="0" angy="0" angz="0" />
            <timevalue time="0.16" linx="0" liny="0" linz="-0.00500" angx="0" angy="0" angz="0" />
            <timevalue time="0.21" linx="0" liny="0" linz="-0.00625" angx="0" angy="0" angz="0" />
            <timevalue time="0.26" linx="0" liny="0" linz="-0.00750" angx="0" angy="0" angz="0" />
            <timevalue time="0.31" linx="0" liny="0" linz="-0.00875" angx="0" angy="0" angz="0" />
            <timevalue time="0.36" linx="0" liny="0" linz="-0.01000" angx="0" angy="0" angz="0" />
            <timevalue time="5.00" linx="0" liny="0" linz="-0.01000" angx="0" angy="0" angz="0" />
          </acctimes>
        </accinput>
      </accinputs>
    </special>

    <parameters>
      <parameter key="SavePosDouble" value="0" />
      <parameter key="StepAlgorithm" value="2" />
      <parameter key="Kernel" value="2" />
      <parameter key="ViscoTreatment" value="1" />
      <parameter key="Visco" value="0.05" />
      <parameter key="DensityDT" value="0" />
      <parameter key="Shifting" value="0" />
      <parameter key="RigidAlgorithm" value="2" />
      <parameter key="FtPause" value="0.0" />
      <parameter key="DtIni" value="0" />
      <parameter key="DtMin" value="0.000001" />
      <parameter key="DtAllParticles" value="0" />
      <parameter key="TimeMax" value="10.0" />
      <parameter key="TimeOut" value="0.01" />
      <simulationdomain>
        <posmin x="default-100%" y="default-1000%" z="default-2000%" />
        <posmax x="default+100%" y="default+1000%" z="default+2000%" />
      </simulationdomain>
    </parameters>
  </execution>
</case>
